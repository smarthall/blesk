{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":automergeAll"
  ],
  "enabledManagers": [
    "poetry",
    "pre-commit",
    "github-actions"
  ],
  "packageRules": [
    {
      "description": "Never automerge Python version updates - they change the range of supported interpreters",
      "matchPackageNames": ["python"],
      "automerge": false,
      "platformAutomerge": false
    }
  ]
}
